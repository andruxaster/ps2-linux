#!/bin/sh
# zram swap: compressed swap in RAM.  /etc/init.d/zram start|stop|status
. /etc/rc.conf
Z=/sys/block/zram0

case "$1" in
start)
	[ "$ZRAM" = yes ] || exit 0
	grep -q '^/dev/zram0 ' /proc/swaps && exit 0
	if ! modprobe zram num_devices=1 2>/dev/null; then
		echo "zram: module not available (kernel built with PROFILE=stock?)" >&2
		exit 0
	fi
	modprobe -q "${ZRAM_ALGO:-lz4}" 2>/dev/null
	# the algorithm must be set before the size; without lz4, lzo-rle stays
	echo "${ZRAM_ALGO:-lz4}" > $Z/comp_algorithm 2>/dev/null ||
		echo "zram: algorithm ${ZRAM_ALGO:-lz4} unavailable, using $(sed 's/.*\[\(.*\)\].*/\1/' $Z/comp_algorithm)" >&2
	echo "${ZRAM_SIZE:-16M}" > $Z/disksize
	mkswap /dev/zram0 >/dev/null
	swapon -p 100 /dev/zram0
	[ -n "$SWAPPINESS" ] && echo "$SWAPPINESS" > /proc/sys/vm/swappiness
	;;
stop)
	grep -q '^/dev/zram0 ' /proc/swaps && swapoff /dev/zram0
	[ -e $Z/reset ] && echo 1 > $Z/reset
	;;
status)
	cat /proc/swaps
	if [ -r $Z/mm_stat ]; then
		# mm_stat: original size, compressed size, memory used (bytes)
		set -- $(cat $Z/mm_stat)
		echo "zram: data $(($1 / 1024)) KiB -> compressed $(($2 / 1024)) KiB, memory $(($3 / 1024)) KiB," \
		     "algorithm $(sed 's/.*\[\(.*\)\].*/\1/' $Z/comp_algorithm)"
	fi
	;;
*)
	echo "usage: $0 start|stop|status" >&2; exit 1
	;;
esac
