#!/bin/sh
# Networking over USB Ethernet (the interface appears a while after the module loads).
. /etc/rc.conf
i=0
while [ ! -d "/sys/class/net/$IFACE" ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
if [ ! -d "/sys/class/net/$IFACE" ]; then
	logger -t network "$IFACE did not appear - is the network adapter plugged in?"
	exit 0
fi

case "$NET" in
dhcp)
	udhcpc -b -S -i "$IFACE" -x hostname:"$(hostname)" -s /usr/share/udhcpc/default.script
	;;
static)
	ip addr add "$IP" dev "$IFACE"
	ip link set "$IFACE" up
	[ -n "$GATEWAY" ] && ip route add default via "$GATEWAY"
	[ -n "$DNS" ] && echo "nameserver $DNS" > /etc/resolv.conf
	;;
esac

if [ -n "$NTP_SERVER" ]; then
	sleep 3
	ntpd -p "$NTP_SERVER" && hwclock -w -u 2>/dev/null
fi
