#!/bin/busybox sh
# PS2 Linux initramfs: bring up the IOP and USB, find the root filesystem on
# the USB stick, switch_root.
#
# The root partition is found by label ps2root (findfs), otherwise /dev/sda2.
# Video mode: first line of VIDEO.TXT on the FAT partition, otherwise @VIDEO@.

/bin/busybox --install -s
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
echo 0 > /proc/sys/kernel/printk_ratelimit 2>/dev/null
[ -f "/lib/modules/$(uname -r)/modules.dep" ] || depmod

rescue() {
	echo "initramfs: $*" >&2
	modprobe ps2fb mode_option="${VIDEO:-@VIDEO@}" 2>/dev/null
	echo "initramfs rescue shell. Type 'exit' to retry booting." >&2
	setsid cttyhack sh
	exec /init
}

# IOP and USB, from /etc/initramfs-modules (ps2fb is loaded below, with the video mode)
grep -v '^#' /etc/initramfs-modules | while read -r m; do
	[ -z "$m" ] || [ "$m" = ps2fb ] && continue
	modprobe "$m" || echo "initramfs: failed to load module $m" >&2
done

# wait up to 20 seconds for the USB stick
ROOT=
i=0
while [ $i -lt 40 ]; do
	ROOT=$(findfs LABEL=ps2root 2>/dev/null) || ROOT=
	[ -z "$ROOT" ] && [ -b /dev/sda2 ] && ROOT=/dev/sda2
	[ -n "$ROOT" ] && break
	sleep 0.5
	i=$((i + 1))
done

# video mode from the FAT partition (easy to edit on a PC)
VIDEO=@VIDEO@
BOOT=$(findfs LABEL=PS2BOOT 2>/dev/null) || BOOT=/dev/sda1
mkdir -p /boot
if [ -b "$BOOT" ] && mount -t vfat -o ro "$BOOT" /boot 2>/dev/null; then
	if [ -f /boot/VIDEO.TXT ]; then
		v=$(head -n 1 /boot/VIDEO.TXT | tr -d '\r \t')
		[ -n "$v" ] && VIDEO=$v
	fi
	umount /boot
fi
modprobe ps2fb mode_option="$VIDEO"

[ -n "$ROOT" ] || rescue "root partition not found (label ps2root or /dev/sda2)"

# no journal: repair automatically after an unclean shutdown
if [ -x /sbin/e2fsck ]; then
	e2fsck -p "$ROOT"
	[ $? -ge 4 ] && rescue "e2fsck could not repair $ROOT - run 'e2fsck -f $ROOT'"
fi

mount -t ext4 -o rw,noatime "$ROOT" /newroot || rescue "cannot mount $ROOT"
[ -x /newroot/sbin/init ] || rescue "no /sbin/init on $ROOT"

mount --move /dev /newroot/dev
umount /sys /proc
exec switch_root /newroot /sbin/init
